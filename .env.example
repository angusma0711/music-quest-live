# Copy to .env.local (never commit .env.local).
# Leave VITE_USE_EMULATORS=true for local classroom testing without a real Firebase project.
VITE_USE_EMULATORS=true

# Fill these from Firebase console > Project settings > Your apps (web). These are public
# web-config values, NOT secrets — security comes from database.rules.json.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
